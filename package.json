{
  "name": "@powerhousedao/network-admin",
  "description": "Network Admin package for Powerhouse",
  "version": "1.2.1",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerhouse-inc/network-admin"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./document-models": {
      "types": "./dist/document-models/index.d.ts",
      "default": "./dist/document-models/index.js"
    },
    "./editors": {
      "types": "./dist/editors/index.d.ts",
      "default": "./dist/editors/index.js"
    },
    "./document-models/*": {
      "types": "./dist/document-models/*/index.d.ts",
      "default": "./dist/document-models/*/index.js"
    },
    "./editors/*": {
      "types": "./dist/editors/*/index.d.ts",
      "default": "./dist/editors/*/index.js"
    },
    "./subgraphs": {
      "types": "./dist/subgraphs/index.d.ts",
      "default": "./dist/subgraphs/index.js"
    },
    "./processors": {
      "types": "./dist/processors/index.d.ts",
      "default": "./dist/processors/index.js"
    },
    "./manifest": {
      "default": "./dist/powerhouse.manifest.json"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "npm run tsc && npm run tailwind",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --config eslint.config.js --cache --cache-strategy content",
    "lint:fix": "npm run lint -- --fix",
    "tsc": "tsc",
    "tsc:watch": "tsc --watch",
    "tailwind": "bunx tailwindcss -i ./style.css -o ./dist/style.css",
    "prepublishOnly": "npm run build",
    "check-circular-imports": "npx dpdm -T ./index.ts",
    "generate": "ph-cli generate",
    "connect": "ph-cli connect",
    "reactor": "ph-cli reactor",
    "service": "ph-cli service",
    "vetra": "ph-cli vetra",
    "migrate": "ph-cli migrate",
    "service-startup": "bash ./node_modules/@powerhousedao/ph-cli/dist/scripts/service-startup.sh",
    "service-unstartup": "bash ./node_modules/@powerhousedao/ph-cli/dist/scripts/service-unstartup.sh"
  },
  "dependencies": {
    "@powerhousedao/builder-profile": "1.0.7",
    "@powerhousedao/builder-tools": "6.2.0-dev.36",
    "@powerhousedao/common": "6.2.0-dev.36",
    "@powerhousedao/design-system": "6.2.0-dev.36",
    "@powerhousedao/document-engineering": "^1.40.1",
    "@powerhousedao/project-management": "1.0.4",
    "@powerhousedao/vetra": "6.2.0-dev.36",
    "@uiw/react-md-editor": "^4.0.8",
    "document-model": "6.2.0-dev.36",
    "error": "^10.4.0",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "lucide-react": "^0.546.0",
    "luxon": "^3.7.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@eslint/js": "^9.38.0",
    "@powerhousedao/analytics-engine-core": "6.2.0-dev.36",
    "@powerhousedao/codegen": "6.2.0-dev.36",
    "@powerhousedao/config": "6.2.0-dev.36",
    "@powerhousedao/connect": "6.2.0-dev.36",
    "@powerhousedao/ph-cli": "6.2.0-dev.36",
    "@powerhousedao/reactor": "6.2.0-dev.36",
    "@powerhousedao/reactor-api": "6.2.0-dev.36",
    "@powerhousedao/reactor-browser": "6.2.0-dev.36",
    "@powerhousedao/shared": "6.2.0-dev.36",
    "@powerhousedao/scalars": "^2.0.1",
    "@powerhousedao/switchboard": "6.2.0-dev.36",
    "@tailwindcss/cli": "^4.1.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "package-manager-detector": "^0.2.8",
    "pm2": "^5.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.2.3",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^3.0.9",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^25.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "staging",
        "prerelease": "staging"
      },
      {
        "name": "dev",
        "prerelease": "dev"
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "chore",
              "release": "patch"
            },
            {
              "type": "ci",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  },
  "readme": "ERROR: No README data found!",
  "overrides": {
    "graphql": "16.13.0",
    "zod": "4.3.6"
  },
  "resolutions": {
    "graphql": "16.13.0",
    "zod": "4.3.6"
  }
}
